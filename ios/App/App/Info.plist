<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 31/08/2026 : sans cette liste, canOpenURL renvoie toujours false et le bouton
	     « Ouvrir Spotify » croit que l'app n'est pas installee. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>spotify</string>
		<string>music</string>
	</array>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>REPS</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>REPS utilise la caméra pour filmer votre WOD et y incruster le chronomètre.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>REPS enregistre le son ambiant avec votre vidéo de WOD.</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<!-- 07/09/2026 : verrouillage en portrait.
	     L'app autorisait les deux paysages, mais la feuille de style n'a AUCUNE
	     regle pour cette orientation. Constate sur un enregistrement d'ecran de
	     Francois : logo a la verticale, boutons couches, chiffre du decompte
	     coupe par le bord de l'ecran, chrono reduit a une barre noire. L'app
	     etait inutilisable en plein WOD, et il suffit de poser le telephone de
	     travers sur un banc pour y tomber.
	     Le portrait n'est pas un repli, c'est la forme du produit : chrono lu a
	     bout de bras, telephone cale debout, et l'export video est en 1080x1920.
	     Rouvrir cette liste quand une vraie mise en page paysage existera. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>REPS enregistre ta vidéo de WOD avec le chrono incrusté dans ta photothèque.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- 10/09/2026 : audio en arriere-plan.
	     Retour d'un coach : en mode « Ma musique », il passe sur Spotify pendant le
	     WOD pour changer de morceau, et REPS se tait. Sans cette cle, iOS gele l'app
	     quelques secondes apres qu'on l'a quittee : plus de chrono, plus de voix.
	     Usage legitime aux yeux d'Apple (regle 2.5.4) : REPS joue des annonces
	     vocales pendant la seance, comme une app de course. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
